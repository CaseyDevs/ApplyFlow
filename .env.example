# Environment variables for docker-compose
# Copy this file to .env and fill in the actual values
# DO NOT commit .env to version control

# Database Configuration
DB_NAME=applyflow
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here

# Email Configuration (Gmail SMTP)
# You must use an App Password, not your regular password
# Generate at: https://myaccount.google.com/apppasswords
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here

# Optional: Backend Spring Profile
# prod, staging, dev
SPRING_PROFILES_ACTIVE=prod

# Public URLs used by the browser and email links
APP_FRONTEND_URL=https://applyflow.example.com
CORS_ALLOWED_ORIGINS=https://applyflow.example.com
VITE_API_BASE_URL=https://api.applyflow.example.com

# Optional published host ports for docker-compose.prod.yml
FRONTEND_PORT=80
BACKEND_PORT=8080

# Optional image names; GitHub Actions can publish these to GHCR
FRONTEND_IMAGE=applyflow-frontend:prod
BACKEND_IMAGE=applyflow-backend:prod
