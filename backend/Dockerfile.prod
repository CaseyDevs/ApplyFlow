# Stage 1: Build
# Use Eclipse Temurin JDK 21 to build the Spring Boot application
FROM eclipse-temurin:21-jdk-jammy AS builder

WORKDIR /app

# Copy Gradle wrapper and configuration
COPY gradlew gradlew
COPY gradle gradle
COPY build.gradle settings.gradle ./
RUN chmod +x gradlew

# Pre-fetch dependencies for faster builds
RUN ./gradlew --no-daemon --quiet dependencies >/dev/null || true

# Copy source code
COPY src src

# Build the application JAR
RUN ./gradlew --no-daemon clean bootJar -x test

# Stage 2: Runtime
FROM eclipse-temurin:21-jre-jammy

WORKDIR /app

RUN groupadd --system applyflow && useradd --system --gid applyflow --home-dir /app applyflow

# Copy the built JAR from builder stage
COPY --from=builder --chown=applyflow:applyflow /app/build/libs/*.jar application.jar

# Expose port 8080
EXPOSE 8080

# Set Java options for production (e.g., memory limits)
ENV JAVA_OPTS="-XX:+UseG1GC -XX:MaxRAMPercentage=75 -XX:InitialRAMPercentage=25"

USER applyflow

HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
  CMD bash -c '</dev/tcp/127.0.0.1/8080' || exit 1

# Run the application
CMD ["sh", "-c", "java $JAVA_OPTS -jar application.jar"]
